{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Engram operator-console parity ledger",
  "type": "object",
  "required": ["design_version", "design_snapshot_sha256", "sections"],
  "properties": {
    "design_version": { "type": "string", "description": "Must equal design/operator-console/PROMOTION-MANIFEST.json." },
    "design_snapshot_sha256": { "type": "string", "description": "Must equal PROMOTION-MANIFEST.json content_sha256." },
    "sections": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "mockup", "runtime", "fidelity", "sync", "synced_to", "synced_snapshot", "visual_evidence"], "properties": {
      "id": { "type": "string" }, "kind": { "enum": ["route", "frame"] }, "route": { "type": ["string", "null"] }, "mockup": { "type": "string" }, "runtime": { "type": "string" },
      "fidelity": { "enum": ["full", "interactive", "structural", "stub"] }, "sync": { "enum": ["synced", "drifted", "ahead"] }, "synced_to": { "type": ["string", "null"] }, "synced_snapshot": { "type": ["string", "null"] }, "visual_evidence": { "type": "array", "items": { "type": "string" } }, "gaps": { "type": "array", "items": { "type": "string" } }
    } } }
  }
}

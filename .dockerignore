.agent/
continuity.txt

# Website docs (not the generated OpenAPI docs)
docs/node_modules/
docs/dist/
docs/src/
docs/.vitepress/
docs/package.json
docs/package-lock.json

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
*~

# Go caches (use Docker layer cache instead)
.gocache/
.gomodcache/
.tmp-gocache/

# Node modules (will be installed fresh in Docker)
ui/node_modules/
apps/operator-console/node_modules/
apps/operator-console/.nuxt/
apps/operator-console/.output/

# Test artifacts
coverage.out
coverage.html


# Single-owner server: the 14 Unraid template variables, not a complete runtime reference.
# Keep existing provider and Vault values when updating. Never replace a live key.
# Docker image supplies HOME, ENGRAM_WORKER_HOST=0.0.0.0 and ENGRAM_WORKER_PORT=37777.
# Compose's database/image/network inputs are separate; see docs/arch/CONFIGURATION.md.
TZ=UTC
DATABASE_DSN=postgres://engram:change-me@postgres:5432/engram?sslmode=disable
ENGRAM_VAULT_KEY=
ENGRAM_EMBEDDING_URL=
ENGRAM_EMBEDDING_API_KEY=
ENGRAM_EMBEDDING_MODEL=text-embedding
ENGRAM_EMBEDDING_DIMENSIONS=1536
ENGRAM_LLM_URL=
ENGRAM_LLM_API_KEY=
ENGRAM_LLM_MODEL=chat-default
# Explicit security choice. Keep true only for the owner's trusted single-user LAN.
ENGRAM_AUTH_DISABLED=false
# Server-host-only token retained for authenticated recovery. Never put it on a workstation.
ENGRAM_AUTH_ADMIN_TOKEN=
ENGRAM_CODE_INTEL_ENABLED=true
ENGRAM_TELEMETRY_ENABLED=true

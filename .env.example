# Engram — Environment Configuration
# Copy to .env and edit:  cp .env.example .env
#
# Only the variables below are read by the server. The names match exactly what
# the Go code reads (internal/config/config.go, internal/embedding/client.go,
# internal/llm/client.go) — do NOT reintroduce legacy names
# (EMBEDDING_PROVIDER, FALKORDB_*); the code ignores them.
# See docs/arch/CONFIGURATION.md for the full reference.

# ── PostgreSQL (docker-compose level) ────────────────────────────────────────
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432
WORKER_PORT=37777
OPERATOR_CONSOLE_PORT=3000
# Optional override: when set, the worker proxies browser routes to this upstream
# instead of serving the embedded operator-console bundle.
# ENGRAM_OPERATOR_CONSOLE_URL=http://operator-console:3000
# Optional display label for the backend host shown in the operator console UI.
# Leave empty to fall back to the current console host label.
OPERATOR_CONSOLE_API_DISPLAY_HOST=

# ── Bootstrap (required / start-critical) ────────────────────────────────────
# For an EXTERNAL Postgres, set DATABASE_DSN here; docker-compose interpolates it
# (${DATABASE_DSN:-...}) and falls back to the bundled postgres service when unset.
# DATABASE_DSN=postgres://user:pass@external-host:5432/engram?sslmode=disable

# Operator admin token. Lives ONLY on the server host — never on a workstation.
ENGRAM_AUTH_ADMIN_TOKEN=
# Local smoke/debug only. Keep false in real deployments unless you are
# deliberately validating an auth-disabled stand.
ENGRAM_AUTH_DISABLED=false

# AES-256-GCM vault master key. Required only if you use the credential vault.
# Must be 64 hex characters (= 32 bytes), e.g. `openssl rand -hex 32`.
# A key file (ENGRAM_ENCRYPTION_KEY_FILE) may instead hold 32 raw bytes or 64 hex.
# ENGRAM_ENCRYPTION_KEY is an accepted alias.
ENGRAM_VAULT_KEY=

# ── Embedding (semantic memory) ──────────────────────────────────────────────
# OpenAI-compatible /v1/embeddings endpoint. Empty URL = embedding disabled;
# hybrid recall then degrades gracefully to FTS-only (no vector tier).
ENGRAM_EMBEDDING_URL=
ENGRAM_EMBEDDING_MODEL=text-embedding
# Sent as "Authorization: Bearer <key>" when set. Leave empty for a key-less
# LAN endpoint (e.g. a trusted-network LiteLLM/Ollama proxy).
ENGRAM_EMBEDDING_API_KEY=

# ── LLM (crystallization / query expansion) ──────────────────────────────────
# OpenAI-compatible /v1/chat/completions endpoint. Empty URL = LLM disabled;
# crystallization features that require inference become a no-op.
ENGRAM_LLM_URL=
ENGRAM_LLM_MODEL=chat-default
# Sent as "Authorization: Bearer <key>" when set. Leave empty for a key-less
# LAN endpoint (e.g. a trusted-network LiteLLM/Ollama proxy).
ENGRAM_LLM_API_KEY=

# ── vNext feature flags (all default OFF; flag-OFF == v6.4.15 byte-identical) ─
# Activate in this order; F requires the master gate. See CONFIGURATION.md.
ENGRAM_VNEXT_ENABLED=false
ENGRAM_LIFECYCLE_ENABLED=false
ENGRAM_VNEXT_F_ENABLED=false
ENGRAM_GRAPH_ENABLED=false
ENGRAM_TEMPORAL_TRUTH_ENABLED=false
ENGRAM_CRYSTALLIZATION_ENABLED=false

# ── Optional tuning ──────────────────────────────────────────────────────────
# ENGRAM_SNAPSHOT_RETENTION_DAYS=30
# ENGRAM_REDACTION_RULES_PATH=/etc/engram/redaction.json
# ENGRAM_WORKER_HOST=0.0.0.0

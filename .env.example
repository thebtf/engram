# Single-owner normal startup: exactly four configured Unraid Variable rows.
# Before removing provider ENV, privately synchronize and verify the seven existing
# model_settings keys documented in docs/arch/CONFIGURATION.md. Keep the SAME Vault key.
TZ=UTC
# Leave empty for bundled Compose PostgreSQL; it uses POSTGRES_PASSWORD.
# For external PostgreSQL, set its explicit connection string here.
DATABASE_DSN=
ENGRAM_VAULT_KEY=
# Explicit trusted single-user LAN choice, not a permanent no-auth code default.
ENGRAM_AUTH_DISABLED=true

# Auth-on only: set the choice above to false and supply the existing token here
# or via shell. Compose forwards it automatically; preserve the private rollback value.
# ENGRAM_AUTH_ADMIN_TOKEN=
# Optional emergency stops; both capabilities otherwise retain their default true.
# ENGRAM_CODE_INTEL_ENABLED=false
# ENGRAM_TELEMETRY_ENABLED=false

# Optional provider overrides: supplied .env/shell values are forwarded by Compose.
# Nonempty ENV wins over the existing encrypted DB settings; absent values stay unset.
# ENGRAM_EMBEDDING_URL=
# ENGRAM_EMBEDDING_API_KEY=
# ENGRAM_EMBEDDING_MODEL=text-embedding
# ENGRAM_EMBEDDING_DIMENSIONS=1536
# ENGRAM_LLM_URL=
# ENGRAM_LLM_API_KEY=
# ENGRAM_LLM_MODEL=chat-default
# HOME and worker bind/port come from the image. Compose's database/image/network
# inputs are orchestration settings, not additional owner-template Variable rows.

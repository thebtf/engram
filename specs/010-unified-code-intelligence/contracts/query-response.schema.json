{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engram code-query response contract, designed not implemented",
  "$comment": "This schema covers query responses only. COMPLETION_EVIDENCE_UNAVAILABLE is valid only on the separate verified supported-host completion callback and is intentionally excluded from this query error enum.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "exposure"
  ],
  "properties": {
    "schema": {
      "const": "engram.code-query/1"
    },
    "status": {
      "enum": [
        "ok",
        "empty",
        "partial",
        "stale",
        "unavailable",
        "context_required",
        "forbidden"
      ]
    },
    "contexts": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "checkout_id",
          "view_id",
          "generation",
          "profile_id"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "format": "uuid"
          },
          "checkout_id": {
            "type": "string",
            "format": "uuid"
          },
          "view_id": {
            "type": "string",
            "format": "uuid"
          },
          "profile_id": {
            "type": "string",
            "format": "uuid"
          },
          "space_id": {
            "type": "string",
            "format": "uuid"
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "method",
        "pending_changes",
        "enrichment_watermark",
        "barrier"
      ],
      "properties": {
        "state": {
          "enum": [
            "observed_current",
            "catching_up",
            "offline",
            "unknown",
            "historical"
          ]
        },
        "method": {
          "enum": [
            "watch_watermark",
            "path_hash_barrier",
            "full_reconcile",
            "pinned_history",
            "none"
          ]
        },
        "pending_changes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "enrichment_watermark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "state"
          ],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "state": {
              "enum": [
                "current",
                "pending",
                "unavailable"
              ]
            }
          }
        },
        "barrier": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "scope",
            "deadline_ms",
            "state"
          ],
          "properties": {
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "path_count"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "paths",
                    "paths_with_hashes"
                  ]
                },
                "path_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                }
              }
            },
            "deadline_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "state": {
              "enum": [
                "satisfied",
                "stale",
                "timed_out"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "path_hash_barrier"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "barrier": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "vector_coverage",
        "degradation_reasons"
      ],
      "properties": {
        "mode": {
          "enum": [
            "exact",
            "lexical",
            "hybrid",
            "graph",
            "unavailable"
          ]
        },
        "vector_coverage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "degradation_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structural",
        "unresolved_sites",
        "unsupported_files"
      ],
      "properties": {
        "structural": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "unresolved_sites": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unsupported_files": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "exposure": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "exposure_ref",
        "completion_state"
      ],
      "properties": {
        "exposure_ref": {
          "type": "string",
          "minLength": 9,
          "maxLength": 128,
          "pattern": "^uci-exp_[A-Za-z0-9_-]+$"
        },
        "completion_state": {
          "enum": [
            "unknown",
            "succeeded",
            "partial",
            "failed",
            "abandoned"
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "CONTEXT_REQUIRED",
            "CONTEXT_MISMATCH",
            "VIEW_RETIRED",
            "SOURCE_UNAVAILABLE",
            "CHECKOUT_OFFLINE",
            "INDEX_CATCHING_UP",
            "PARSER_UNSUPPORTED",
            "PARSER_PARTIAL",
            "VECTOR_UNAVAILABLE",
            "PROFILE_MISMATCH",
            "BUDGET_EXCEEDED",
            "LEASE_STALE",
            "BUILD_INCOMPLETE",
            "PERMISSION_DENIED",
            "EXPOSURE_UNAVAILABLE",
            "IDEMPOTENCY_MISMATCH"
          ]
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "path",
          "span",
          "content_digest",
          "kind",
          "language",
          "excerpt",
          "match_sources"
        ],
        "properties": {
          "ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "view_id",
              "entity_key"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "format": "uuid"
              },
              "view_id": {
                "type": "string",
                "format": "uuid"
              },
              "entity_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "span": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "byte_start",
              "byte_end",
              "line_start",
              "line_end"
            ],
            "properties": {
              "byte_start": {
                "type": "integer",
                "minimum": 0
              },
              "byte_end": {
                "type": "integer",
                "minimum": 0
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "code",
              "document",
              "schema",
              "config"
            ]
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "excerpt": {
            "type": "string",
            "maxLength": 8192
          },
          "match_sources": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "exact",
                "fts",
                "vector",
                "graph"
              ]
            },
            "minItems": 1
          },
          "score": {
            "type": "number"
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges",
        "stop_reason"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "view_id",
              "entity_key"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "format": "uuid"
              },
              "view_id": {
                "type": "string",
                "format": "uuid"
              },
              "entity_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "relation",
              "evidence_kind",
              "evidence_refs"
            ],
            "properties": {
              "from": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_id",
                  "view_id",
                  "entity_key"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "view_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "entity_key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              },
              "to": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_id",
                  "view_id",
                  "entity_key"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "view_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "entity_key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              },
              "relation": {
                "enum": [
                  "contains",
                  "imports",
                  "exports",
                  "references",
                  "calls",
                  "may_call",
                  "inherits",
                  "implements",
                  "documents",
                  "mentions",
                  "configures",
                  "schema_references",
                  "tests",
                  "depends_on"
                ]
              },
              "evidence_kind": {
                "enum": [
                  "EXTRACTED",
                  "RESOLVED",
                  "HEURISTIC",
                  "SEMANTIC"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_id",
                    "view_id",
                    "entity_key"
                  ],
                  "properties": {
                    "source_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "view_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "entity_key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  }
                }
              },
              "explanation": {
                "type": "string",
                "maxLength": 2048
              }
            }
          }
        },
        "stop_reason": {
          "enum": [
            "complete",
            "depth_cap",
            "node_cap",
            "deadline",
            "coverage_gap"
          ]
        }
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 2048
      }
    },
    "continuation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "empty",
              "partial",
              "stale"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "contexts",
          "freshness",
          "retrieval",
          "coverage",
          "items",
          "truncated",
          "warnings",
          "continuation"
        ],
        "properties": {
          "exposure": {
            "type": "object"
          }
        },
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "context_required",
              "forbidden"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "exposure": {
            "type": "null"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "contexts"
              ]
            },
            {
              "required": [
                "freshness"
              ]
            },
            {
              "required": [
                "retrieval"
              ]
            },
            {
              "required": [
                "coverage"
              ]
            },
            {
              "required": [
                "items"
              ]
            },
            {
              "required": [
                "truncated"
              ]
            },
            {
              "required": [
                "warnings"
              ]
            },
            {
              "required": [
                "continuation"
              ]
            },
            {
              "required": [
                "graph"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error"
        ],
        "oneOf": [
          {
            "required": [
              "contexts",
              "freshness",
              "retrieval",
              "coverage",
              "items",
              "truncated",
              "warnings",
              "continuation"
            ],
            "properties": {
              "exposure": {
                "type": "object"
              },
              "error": {
                "properties": {
                  "code": {
                    "enum": [
                      "VIEW_RETIRED",
                      "SOURCE_UNAVAILABLE",
                      "CHECKOUT_OFFLINE",
                      "INDEX_CATCHING_UP",
                      "PARSER_UNSUPPORTED",
                      "PARSER_PARTIAL",
                      "VECTOR_UNAVAILABLE",
                      "PROFILE_MISMATCH",
                      "BUDGET_EXCEEDED",
                      "LEASE_STALE",
                      "BUILD_INCOMPLETE"
                    ]
                  }
                }
              },
              "items": {
                "maxItems": 0
              }
            },
            "not": {
              "required": [
                "graph"
              ]
            }
          },
          {
            "properties": {
              "exposure": {
                "type": "null"
              },
              "error": {
                "properties": {
                  "code": {
                    "enum": [
                      "EXPOSURE_UNAVAILABLE",
                      "IDEMPOTENCY_MISMATCH"
                    ]
                  }
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "contexts"
                  ]
                },
                {
                  "required": [
                    "freshness"
                  ]
                },
                {
                  "required": [
                    "retrieval"
                  ]
                },
                {
                  "required": [
                    "coverage"
                  ]
                },
                {
                  "required": [
                    "items"
                  ]
                },
                {
                  "required": [
                    "truncated"
                  ]
                },
                {
                  "required": [
                    "warnings"
                  ]
                },
                {
                  "required": [
                    "continuation"
                  ]
                },
                {
                  "required": [
                    "graph"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "context_required"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "enum": [
                  "CONTEXT_REQUIRED",
                  "CONTEXT_MISMATCH"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "forbidden"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "PERMISSION_DENIED"
              }
            }
          }
        }
      }
    }
  ]
}

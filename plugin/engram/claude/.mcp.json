{
  "mcpServers": {
    "engram": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/run-engram.js"
      ],
      "cwd": ".",
      "env_vars": [
        "ENGRAM_URL",
        "ENGRAM_TOKEN",
        "ENGRAM_SERVER_URL",
        "ENGRAM_DATA_DIR"
      ],
      "startup_timeout_sec": 60
    }
  }
}
